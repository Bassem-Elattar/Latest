<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Suite" parallel="false" preserve-order="true" verbose="2">

    <test name="Role Module">
        <classes>
            <class name="AdminPages.Admin.Company.Role.Role_TC">
                <methods>
                    <include name="verifyThatUserCanCreateRoleWithViewOnly"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Cancellation Charge Module">
        <classes>
            <class name="AdminPages.RuleEngine.CancellationCharge.CancellationCharge_TC">
                <methods>
                    <include name="CreateCancellationCharge"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Booking Search Module">
        <classes>
            <class name="AdminPages.BookingMidOffice.SearchBooking.SearchBookingTCs">
                <methods>
                    <include name="verifyThatUserCanSearchByOrderID"/>
                </methods>
            </class>
        </classes>
    </test>



</suite>